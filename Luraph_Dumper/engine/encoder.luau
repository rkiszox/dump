local filter = require("./filter")

local string_format = string.format
local string_gsub = string.gsub
local string_byte = string.byte
local table_concat = table.concat

local escape_map = {
    ["\\"] = "\\\\",
    ["\""] = "\\\"",
    ["\b"] = "\\b",
    ["\f"] = "\\f",
    ["\n"] = "\\n",
    ["\r"] = "\\r",
    ["\t"] = "\\t"
}

local function escape_json_string(s: string): string
    return '"' .. string_gsub(s, '[\\"%z\1-\31]', function(c)
        if escape_map[c] then
            return escape_map[c]
        else
            return string_format("\\u%04x", string_byte(c))
        end
    end) .. '"'
end

local function json_encode(val: any): string
    local t = type(val)
    if t == "string" then
        return escape_json_string(val)
    elseif t == "number" then
        if val ~= val then return "null" end
        if val == math.huge or val == -math.huge then return "null" end
        return tostring(val)
    elseif t == "boolean" then
        return tostring(val)
    elseif t == "nil" then
        return "null"
    elseif t == "table" then
        local is_array = true
        local count = 0
        for k, _ in pairs(val) do
            count += 1
            if type(k) ~= "number" or k <= 0 or math.floor(k) ~= k then
                is_array = false
                break
            end
        end
        if is_array and count > 0 then
            for i = 1, count do
                if val[i] == nil then
                    is_array = false
                    break
                end
            end
        end
        if is_array then
            local parts = {}
            for i = 1, count do
                parts[#parts + 1] = json_encode(val[i])
            end
            return "[" .. table_concat(parts, ",") .. "]"
        else
            local parts = {}
            for k, v in pairs(val) do
                parts[#parts + 1] = escape_json_string(tostring(k)) .. ":" .. json_encode(v)
            end
            return "{" .. table_concat(parts, ",") .. "}"
        end
    else
        return escape_json_string(tostring(val))
    end
end

local function build_lua_output(proto_list: any): string
    local lines = {}
    lines[#lines + 1] = "-- This File Generated By im_mxrtal On Discord"
    lines[#lines + 1] = "return {"
    lines[#lines + 1] = "    protos = {"

    for _, p in ipairs(proto_list) do
        local clean_strings = {}
        for _, s in ipairs(p.strings or {}) do
            if filter.is_clean_constant_string(s.value) then
                clean_strings[#clean_strings + 1] = s.value
            end
        end

        local clean_numbers = {}
        for _, n in ipairs(p.numbers or {}) do
            if type(n.value) == "number" and n.value == n.value and n.value ~= math.huge and n.value ~= -math.huge then
                clean_numbers[#clean_numbers + 1] = n.value
            end
        end

        local clean_booleans = {}
        for _, b in ipairs(p.booleans or {}) do
            clean_booleans[#clean_booleans + 1] = b.value
        end

        local clean_prefs = p.proto_references or {}

        local has_content = (#clean_strings > 0) or (#clean_booleans > 0) or (#clean_numbers > 0) or (#clean_prefs > 0)
        if has_content then
            lines[#lines + 1] = string_format("        [%d] = {", p.id)
            if #clean_strings > 0 then
                lines[#lines + 1] = "            strings = {"
                for idx, s_val in ipairs(clean_strings) do
                    lines[#lines + 1] = string_format("                [%d] = %q,", idx - 1, s_val)
                end
                lines[#lines + 1] = "            },"
            end
            if #clean_booleans > 0 then
                lines[#lines + 1] = "            booleans = {"
                for idx, b_val in ipairs(clean_booleans) do
                    lines[#lines + 1] = string_format("                [%d] = %s,", idx - 1, tostring(b_val))
                end
                lines[#lines + 1] = "            },"
            end
            if #clean_numbers > 0 then
                lines[#lines + 1] = "            numbers = {"
                for idx, n_val in ipairs(clean_numbers) do
                    lines[#lines + 1] = string_format("                [%d] = %s,", idx - 1, tostring(n_val))
                end
                lines[#lines + 1] = "            },"
            end
            if #clean_prefs > 0 then
                lines[#lines + 1] = "            proto_references = {"
                for idx, pref in ipairs(clean_prefs) do
                    lines[#lines + 1] = string_format("                [%d] = { proto = %q },", idx - 1, tostring(pref.target))
                end
                lines[#lines + 1] = "            },"
            end
            lines[#lines + 1] = "        },"
        end
    end

    lines[#lines + 1] = "    }"
    lines[#lines + 1] = "}"
    lines[#lines + 1] = "-- This File Generated By im_mxrtal On Discord"

    local cleaned_lines = {}
    for _, l in ipairs(lines) do
        if l and #l > 0 and string_gsub(l, "%s+", "") ~= "" then
            cleaned_lines[#cleaned_lines + 1] = l
        end
    end

    return table_concat(cleaned_lines, "\n")
end

return {
    json_encode = json_encode,
    build_lua_output = build_lua_output
}
